{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "build-markdown-editor",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "sync-markdown-editor",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build: extension + markdown editor",
            "dependsOn": ["npm: build", "npm: build-markdown-editor"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "runOptions": { "runOn": "folderOpen" }
        }
    ]
}
