{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@vscode/markdown-editor": ["src/markdownEditor/packages/markdown-editor/src/index.ts"],
            "@vscode/markdown-editor/editor.css": [
                "src/markdownEditor/packages/markdown-editor/src/view/editor.css"
            ],
            "@vscode/markdown-editor/themes/vscode-default.css": [
                "src/markdownEditor/packages/markdown-editor/src/view/themes/vscode-default.css"
            ],
            "entities/decode": ["node_modules/entities/dist/esm/decode.js"]
        },
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "lib": ["ES2022"],
        "sourceMap": true,
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedParameters": true,
        "types": ["node"],
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "generators/",
        "src/**/*.test.ts",
        "src/**/*.browser.ts",
        "src/test/**",
        "src/markdownEditor/webview/**",
        "src/markdownEditor/playground/**",
        "src/markdownEditor/vendor/**",
        "src/markdownEditor/packages/**"
    ]
}
