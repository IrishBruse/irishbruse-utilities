{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "lib": ["ES2022"],
        "sourceMap": true,
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedParameters": true,
        "types": ["node"],
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.browser.ts",
        "src/test/**",
        "src/markdownEditor/webview/**",
        "src/markdownEditor/vendor/**",
        "src/markdownInline/src/**",
        "src/markdownInline/playground/**",
        "src/markdownInline/tests/**",
        "src/markdownInline/support/**"
    ]
}
