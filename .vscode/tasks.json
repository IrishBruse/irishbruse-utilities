// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "build-markdown-editor",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "build-markdown-inline",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "sync-markdown-editor",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "runOptions": { "runOn": "folderOpen" }
        },
        {
            "type": "npm",
            "script": "watch-markdown-editor",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "runOptions": { "runOn": "folderOpen" }
        },
        {
            "label": "inline markdown: dev server",
            "type": "npm",
            "script": "dev:markdown-inline",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Local:\\s+http://localhost:\\d+/"
                }
            },
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "runOptions": { "runOn": "folderOpen" }
        },
        {
            "label": "inline markdown: open",
            "type": "shell",
            "command": "echo ${input:openInlineMarkdown}",
            "options": {
                "shell": {
                    "executable": "/bin/sh",
                    "args": ["-c"]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "inline markdown",
            "dependsOn": ["inline markdown: dev server", "inline markdown: open"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "openInlineMarkdown",
            "type": "command",
            "command": "simpleBrowser.show",
            "args": ["http://localhost:5175/"]
        }
    ]
}
