// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build: extension",
            "type": "process",
            "command": "node",
            "args": ["esbuild.mjs"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "build-markdown-editor",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "sync-markdown-editor",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "runOptions": { "runOn": "folderOpen" }
        },
        {
            "type": "npm",
            "script": "watch-markdown-editor",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "runOptions": { "runOn": "folderOpen" }
        }
    ]
}
