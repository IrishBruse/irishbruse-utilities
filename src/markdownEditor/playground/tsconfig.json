{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedParameters": true,
        "types": ["vite/client", "vscode-webview"]
    },
    "include": [
        "main.ts",
        "mockHost.ts",
        "emptyFsPromises.ts",
        "../webview/declarations.d.ts"
    ]
}
